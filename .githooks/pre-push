#!/usr/bin/env bash
#
# Wayfarer Design-System pre-push gate.
#
# Blocks pushes when either of the design-system audits reports new violations
# beyond their baselines (.motion-audit-baseline.json, .token-audit-baseline.json).
# Both audits are baseline-aware, so legitimately grandfathered debt does not
# block; only net-new regressions do.
#
# Bypass (emergencies only):       git push --no-verify
# See motion doctrine:             guidelines/Guidelines.md#wayfarer-motion-doctrine
# See token reference:             src/styles/theme.css
# Disable hook entirely:           git config --unset core.hooksPath

set -e

# Colors (degrade gracefully if no TTY)
if [ -t 1 ]; then
  CYAN=$'\033[36m'
  DIM=$'\033[2m'
  RESET=$'\033[0m'
else
  CYAN=''
  DIM=''
  RESET=''
fi

printf '%spre-push: running motion doctrine audit…%s\n' "$CYAN" "$RESET"

if ! npm run --silent lint:motion; then
  printf '\n%spre-push blocked: motion doctrine violations.%s\n' "$CYAN" "$RESET"
  printf '%s  Fix with:  node scripts/fix-motion.js%s\n' "$DIM" "$RESET"
  printf '%s  Override:  git push --no-verify  (use sparingly)%s\n' "$DIM" "$RESET"
  exit 1
fi

printf '%spre-push: running token-adoption audit…%s\n' "$CYAN" "$RESET"

if ! npm run --silent lint:tokens; then
  printf '\n%spre-push blocked: new token violations.%s\n' "$CYAN" "$RESET"
  printf '%s  See:        src/styles/theme.css (semantic tokens)%s\n' "$DIM" "$RESET"
  printf '%s  Refresh:    npm run lint:tokens -- --baseline (only after deliberate debt)%s\n' "$DIM" "$RESET"
  printf '%s  Override:   git push --no-verify  (use sparingly)%s\n' "$DIM" "$RESET"
  exit 1
fi
